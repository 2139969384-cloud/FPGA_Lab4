digraph "Top" {
label="Top";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="hsync", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="key_in", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="key_press", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="pix_data", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="pix_x", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="pix_y", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="rgb", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="sys_clk", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="sys_rst_n", color="black", fontcolor="black" ];
n10 [ shape=diamond, label="vga_clk", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="vsync", color="black", fontcolor="black" ];
c12 [ shape=record, label="{{<p4> pix_data|<p9> sys_rst_n|<p10> vga_clk}|u_VGA_ctrl\nVGA_ctrl|{<p1> hsync|<p5> pix_x|<p6> pix_y|<p7> rgb|<p11> vsync}}" ];
c13 [ shape=record, label="{{<p3> key_press|<p5> pix_x|<p6> pix_y|<p9> sys_rst_n|<p10> vga_clk}|u_VGA_pic\nVGA_pic|{<p4> pix_data}}" ];
c14 [ shape=record, label="{{<p2> key_in|<p9> sys_rst_n|<p10> vga_clk}|u_key_ctrl\nkey_ctrl|{<p3> key_press}}" ];
c15 [ shape=record, label="{{<p8> sys_clk|<p9> sys_rst_n}|u_pll\npll|{<p10> vga_clk}}" ];
c12:p1:e -> n1:w [color="black", label=""];
c15:p10:e -> n10:w [color="black", label=""];
n10:e -> c12:p10:w [color="black", label=""];
n10:e -> c13:p10:w [color="black", label=""];
n10:e -> c14:p10:w [color="black", label=""];
c12:p11:e -> n11:w [color="black", label=""];
n2:e -> c14:p2:w [color="black", label=""];
c14:p3:e -> n3:w [color="black", label=""];
n3:e -> c13:p3:w [color="black", label=""];
c13:p4:e -> n4:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> c12:p4:w [color="black", style="setlinewidth(3)", label=""];
c12:p5:e -> n5:w [color="black", style="setlinewidth(3)", label=""];
n5:e -> c13:p5:w [color="black", style="setlinewidth(3)", label=""];
c12:p6:e -> n6:w [color="black", style="setlinewidth(3)", label=""];
n6:e -> c13:p6:w [color="black", style="setlinewidth(3)", label=""];
c12:p7:e -> n7:w [color="black", style="setlinewidth(3)", label=""];
n8:e -> c15:p8:w [color="black", label=""];
n9:e -> c12:p9:w [color="black", label=""];
n9:e -> c13:p9:w [color="black", label=""];
n9:e -> c14:p9:w [color="black", label=""];
n9:e -> c15:p9:w [color="black", label=""];
}
